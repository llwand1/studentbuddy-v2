  (d) => `从${d[1]}的定义式出发，两边同乘${d[4]}后可以把${d[0]}改写成关于${d[3]}的关系。`,
  (d) => `考试中${d[0]}往往与${d[2]}结合命题，突破口是${d[1]}，检验手段是${d[3]}。`,
  (d) => `注意${d[4]}只在特定条件下成立，一旦${d[0]}超出该范围，${d[2]}就要重新估计。`,
];

/** `copies` 片全文复印；事实句只落在**最后一片**，所以前 60k 字的直塞窗口 100% 看不见它。 */
export function buildCorpus(copies: number): string {
  let s = '';
  for (let i = 0; i < copies; i++) {
    s += `\n\n# 复印部分 ${i + 1}\n\n`;
    for (let c = 0; c < TOPICS.length; c++) {
      const d = DOMAINS[c] as string[];
      s += `第 ${c + 1} 章 ${TOPICS[c]}\n\n`;
      for (let p = 0; p < 40; p++) {
        s += TPL[(c + p) % TPL.length]!(d) + GENERIC[(c + p) % GENERIC.length]! + '\n\n';
        if (p === 20 && i === copies - 1) s += FACTS[c] + '\n\n';
      }
    }
  }
  return s;
}
