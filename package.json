{
  "name": "studentbuddy",
  "version": "2.0.0-alpha.0",
  "private": true,
  "description": "studentbuddy v2 - 本地优先的 AI 学习助手（学→练→析→忆→反馈闭环，学习版豆包）",
  "license": "MIT",
  "engines": {
    "node": ">=22.11.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "node tools/dev.mjs",
    "dev:server": "npm run dev -w @sb/server",
    "dev:web": "npm run dev -w @sb/web",
    "build": "npm run build -w @sb/web && npm run build -w @sb/server",
    "lint": "tsc --noEmit -p packages/shared && tsc --noEmit -p packages/server && tsc --noEmit -p packages/web && eslint packages --max-warnings 0",
    "test": "node tools/test-tmp.mjs",
    "test:raw": "vitest run",
    "gates": "node tools/gates/check.mjs",
    "og:shots": "tsx tools/probes/og-card-cdp.mts",
    "check": "npm run lint && npm run test && npm run gates",
    "metrics": "node tools/metrics.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.19.0",
    "jsdom": "^30.1.0",
    "supertest": "^7.0.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.22.0",
    "vitest": "^2.1.8"
  }
}
