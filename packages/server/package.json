{
  "name": "@sb/server",
  "version": "2.0.0-alpha.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --sourcemap --outfile=dist/index.js --external:express --external:cors --external:better-sqlite3 --external:pino",
    "start:prod": "node dist/index.js"
  },
  "dependencies": {
    "@sb/shared": "*",
    "better-sqlite3": "^11.7.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "pino": "^9.6.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "tsx": "^4.19.2"
  }
}
